# Used by `npm run setup`. Never commit a filled-in .env.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional. When empty, setup generates these and prints the admin key once.
ADMIN_API_KEY=
DATA_KEY=
# Optional. Stored as the Worker secret CF_API_TOKEN so the dashboard Domains page can provision domains.
CLOUDFLARE_DOMAINS_API_TOKEN=
